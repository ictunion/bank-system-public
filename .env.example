# Copy to .env for local development. Production deployments should set these as real
# environment variables instead (systemd unit, Windows service config, container env, etc).

# Standard Postgres connection string. The DB can run anywhere reachable — same host,
# another machine, a managed service. Matches `make db-init && make db-start` defaults
# for local dev (see Makefile).
DATABASE_URL=postgres://bank_system:bank_system@localhost:5433/bank_system?sslmode=disable

# HTTP listen port. Optional, defaults to 25987.
PORT=25987

# Debug/dev mode. Optional, defaults to false. Accepts "1", "true", or "yes".
# - Logs outgoing requests and incoming responses (method, URL, headers, bodies) for
#   external API calls, e.g. Fio. Fio API tokens are redacted from logged URLs.
# - Changes the Fio sync to fetch only the last 90 days via /periods/ instead of the
#   full cursor-based /last/ history. Fio requires strong authorization (SCA), done
#   manually in Fio's own Internet Banking, to serve anything older than 90 days —
#   impractical for local dev. Production should leave this off to get full history.
DEBUG=false

# Skip the Fio sync job entirely — no startup run, no daily 3am run. Optional, defaults
# to false. Accepts "1", "true", or "yes". Use when you don't want the live Fio API
# touched at all, e.g. after seeding fake raw_transactions data locally, so a server
# restart doesn't re-pull and overwrite it with real transactions.
DISABLE_FIO_SYNC=false

# Fio Bank API token (Token pro Internetové bankovnictví). Scoped to one bank account,
# generated in Fio's IB under API access. Used by the daily sync job to call Fio's
# classic export API, `GET https://fioapi.fio.cz/v1/rest/last/{token}/transactions.json`
# (see API_Bankovnictvi.pdf) — not the AISP v2/PSD2 API, which needs TPP certificates.
FIO_TOKEN=""

# Orca (in-house member API) base URL + token for the daily member sync job. Orca's
# normal endpoints require a Keycloak user token (this service has no logged-in user
# behind it), so `/sync/bank/members` instead authenticates via a static shared-secret
# bearer token, generated with a CSPRNG and stored identically on both sides — this env
# var here, and as `sync_token` in Orca's own config. Sent as `Authorization: Bearer
# <token>`. Separate from FIO_TOKEN on purpose — different service, different trust
# boundary; keeps rotation and blast radius independent. Scoped to that one Orca route
# only, not a general Orca credential. See docs/logic-design.md, "Orca Member Sync".
# Not yet consumed by code — no Orca sync job exists yet (see docs/orca-sync-members.md).
# Production value; for local dev point at your local Orca instance instead, e.g.
# ORCA_API_URL=http://127.0.0.1:8000
ORCA_API_URL="https://api.ictunion.cz"
ORCA_SYNC_TOKEN=""

# Keycloak — verifies bearer tokens from the FE for user-facing endpoints (see
# internal/keycloak, docs on GET /members). Same Keycloak instance/realm as the
# rest of ictunion's stack (see ictunion/main-system-public docker-compose.yaml:
# realm "members", dev instance at http://localhost:8180). KEYCLOAK_CLIENT_ID is
# bank-system's own client in that realm — must be created in Keycloak first
# (it doesn't exist in the public realm.json yet), with whatever roles this
# service's endpoints require (e.g. "list-members") assigned to test users.
KEYCLOAK_HOST=http://localhost:8180
KEYCLOAK_REALM=members
KEYCLOAK_CLIENT_ID=bank-system
