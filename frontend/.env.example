# Keycloak — public SPA client, no secret. Same realm as the backend's KEYCLOAK_*
# (see ../.env.example). These values are baked into the bundle at build time, so
# the production build needs the production Keycloak URL passed at `npm run build`
# time (or via a committed .env.production). Nothing here is sensitive.
#
# For local dev the committed .env.development already has working defaults;
# copy this file to .env.local only to override them.

VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=members
VITE_KEYCLOAK_CLIENT_ID=bank-system
