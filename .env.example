# Copy to .env for local development. Production sets these as real env vars instead.

# Postgres connection string.
DATABASE_URL=postgres://bank_system:bank_system@localhost:5433/bank_system?sslmode=disable

# HTTP listen port. Optional, default 25987.
PORT=25987

# Verbose request/response logging for external API calls, and skips the Fio
# sync entirely (use `make seed` for local data instead). Optional, default
# false.
DEBUG=false

# Mounts the Swagger UI at GET /api/docs/*. Dev-only. Optional, default false.
ENABLE_SWAGGER_DOCS=false

# Symmetric key encrypting each bank account's Fio token at rest. Generate
# with `openssl rand -base64 32`. Required.
BANK_TOKEN_ENCRYPTION_KEY=""

# Fio API base URL. Required.
FIO_API_URL="https://fioapi.fio.cz/v1/rest"

# Orca API base URL + shared-secret token for the daily member sync. Required.
ORCA_API_URL="https://api.ictunion.cz"
# Generate with: openssl rand -hex 32. Must match Orca's own sync_token config exactly.	
ORCA_SYNC_TOKEN=""

# Keycloak realm/client verifying bearer tokens. HOST must be https://, except
# for localhost/127.0.0.1/::1. Required.
KEYCLOAK_HOST=http://localhost:8180
KEYCLOAK_REALM=members
KEYCLOAK_CLIENT_ID=bank-system
