# Local dev defaults (committed — no secrets). Vite loads this for `npm run dev`.
# Override in .env.local (gitignored) if your Keycloak runs elsewhere.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=members
VITE_KEYCLOAK_CLIENT_ID=bank-system
# Members' budget site's own client (budget.html). Unset = uses VITE_KEYCLOAK_CLIENT_ID.
VITE_KEYCLOAK_BUDGET_CLIENT_ID=budget-page
